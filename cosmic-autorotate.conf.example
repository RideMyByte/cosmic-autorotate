# cosmic-autorotate settings
# Copy to ~/.config/cosmic-autorotate.conf and adjust.
# Restart afterwards: systemctl --user restart cosmic-autorotate

# Internal display name (see: cosmic-randr list). Empty = auto-detect.
#OUTPUT="eDP-1"

# Fixed mode, only needed if auto-detection fails.
#WIDTH=1920
#HEIGHT=1200
#REFRESH=60

# 1 = only switch between normal and 180° (tent mode), ignore portrait.
ONLY_180=0

# 1 = swap the two portrait orientations if they come out upside down.
SWAP_90=0
